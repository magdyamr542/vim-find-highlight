{
  "name": "vim-find-highlight",
  "displayName": "vim-find-highlight",
  "publisher": "AmrMetwally",
  "icon": "images/icon.png",
  "repository": {
    "url": "https://github.com/magdyamr542/vim-find-highlight"
  },
  "description": "highlighting the chars to reach words with vim find command",
  "version": "0.0.10",
  "engines": {
    "node": ">=22",
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "vimFindHighlight",
      "properties": {
        "vimFindHighlight.charPrimaryColor": {
          "type": "string",
          "default": "red",
          "description": "The color of the char that can be reached with the f motion within one jump"
        },
        "vimFindHighlight.charSecondaryColor": {
          "type": "string",
          "default": "green",
          "description": "The color of the char that can be reached with the f motion with more than one jump"
        },
        "vimFindHighlight.charFontWeight": {
          "type": "string",
          "default": "400",
          "description": "The font weight of the char that can be reached with the f motion",
          "enum": [
            "100",
            "200",
            "300",
            "400",
            "500",
            "600",
            "700",
            "800",
            "900"
          ]
        },
        "vimFindHighlight.enableUnderline": {
          "type": "boolean",
          "default": true,
          "description": "If true, a line will be drawn under the highlighted characters"
        },
        "vimFindHighlight.enableAutoHighlight": {
          "type": "boolean",
          "default": true,
          "description": "If true, the extension will automatically highlight the characters that can be reached with the f motion"
        }
      }
    },
    "commands": [
      {
        "command": "vimFindHighlight.toggleAutoHighlight",
        "title": "Vim Find Highlight: Toggle Auto Highlight"
      },
      {
        "command": "vimFindHighlight.highlightCharacters",
        "title": "Vim Find Highlight: Highlight Characters"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "prepare-deployment": "npx vsce package",
    "publish": "npx vsce publish",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage"
  }
}
